    {
      "name": "Admin Panel",
      "description": "All endpoints require role=ADMIN JWT token (use admin_token variable)",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "  pm.collectionVariables.set('admin_token', json.access);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@vanvedha.com\",\n  \"password\": \"AdminPass@123\"\n}"
            }
          }
        },
        {
          "name": "Dashboard",
          "item": [
            {
              "name": "Get Dashboard Stats",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": "{{base_url}}/admin/dashboard/"
              }
            }
          ]
        },
        {
          "name": "User Management",
          "item": [
            {
              "name": "List All Users",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": {
                  "raw": "{{base_url}}/admin/users/",
                  "host": ["{{base_url}}"],
                  "path": ["admin", "users", ""],
                  "query": [
                    { "key": "role", "value": "CUSTOMER", "disabled": true },
                    { "key": "is_active", "value": "true", "disabled": true },
                    { "key": "is_verified", "value": "false", "disabled": true },
                    { "key": "search", "value": "ravi", "disabled": true },
                    { "key": "ordering", "value": "-date_joined", "disabled": true }
                  ]
                }
              }
            },
            {
              "name": "Get User Detail",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
                      "if (json.id) pm.collectionVariables.set('user_id', json.id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": "{{base_url}}/admin/users/{{user_id}}/"
              }
            },
            {
              "name": "Update User",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{admin_token}}" }
                ],
                "url": "{{base_url}}/admin/users/{{user_id}}/",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"first_name\": \"Updated\",\n  \"last_name\": \"Name\",\n  \"is_verified\": true\n}"
                }
              }
            },
            {
              "name": "Activate User",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
                "url": "{{base_url}}/admin/users/{{user_id}}/activate/"
              }
            },
            {
              "name": "Deactivate User",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
